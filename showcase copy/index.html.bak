  <!-- Configuration File -->
  <script src="config.js"></script>
</head>
<body>
  <div id="top"></div>
  
  <!-- ====================================================================
       ARCHIVAL OUTER SHELL
       ==================================================================== -->
  
  <div class="archive-shell">
    

    <!-- ==================================================================
         STICKY INSTRUMENT HEADER & METADATA BAR
         ================================================================== -->
    <header class="archive-header">
      <!-- Top Technical Telemetry Strip -->
      <div class="header-top-bar">
        <div class="header-meta-left">
          <span><b class="pulse-dot"></b> REF: <strong>DAC-04-ARCHIVE</strong></span>
          <!--<span>SERIES: <strong>SPECULATIVE ARTIFACT</strong></span>-->
          <!--<span>CALIBRATION: <strong>240 HZ LOCKED</strong></span>-->
        </div>
        <div class="header-meta-right">
          <!--<span> <strong>Documentation and onboarding manual for speculative artifact</strong></span>-->
          <button id="open-config-btn" class="archival-badge" title="Inspect or update simulation endpoints">
            ⚙ CONFIG: <span class="js-sim-url-display">http://localhost:8787/laptop/</span>
          </button>
        </div>
      </div>

      <!-- Navigation Links -->
      <div class="header-nav-bar">
        <a href="#" class="brand-sigil" data-target="top">
          <span style="color: var(--accent-rust);">[+]</span> Up // Home
        </a>

        <nav class="nav-links">
