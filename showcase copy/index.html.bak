  <title>READER // Field Instrument DAC-04 — Official Archival Documentation</title>
  
  <meta name="description" content="Official field documentation and onboarding guide for the READER (DAC-04), a speculative field instrument for perceiving what cannot be directly heard.">
  
  <!-- Modern Reset, Design Tokens & Component Styles -->
  <link rel="stylesheet" href="css/variables.css">
  <link rel="stylesheet" href="css/reset.css">
  <link rel="stylesheet" href="css/typography.css">
  <link rel="stylesheet" href="css/layout.css">
