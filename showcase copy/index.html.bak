    <!-- ==================================================================
         07. DEMONSTRATION VIDEO
         ================================================================== -->
    <section id="demonstration" class="archive-section">
       <!--<span class="corner-reg tl">+</span>
      <span class="corner-reg tr">+</span>-->
      <br><br><br>

      <div class="section-archival-header">
        <div class="section-meta-header">
          <span class="section-num">07 // OPERATIONAL ARCHIVE</span>
          <div class="section-line"></div>
          <span class="archival-badge alert">DOCUMENTARY RECORD</span>
        </div>
        <h2 class="section-title">Field Demonstration</h2>
        <p class="section-tagline">
          Watch a complete field interaction before entering the simulation.
        </p>
      </div>

      <div class="video-frame-outer">
        <div class="video-frame-inner">
          <div class="video-placeholder-display">
            <div class="video-play-btn" title="Watch Field Demonstration">▶</div>
            <div style="font-family: var(--font-mono); font-size: 1.1rem; font-weight: 700; letter-spacing: 0.12em; color: #fff;">
              [ DEMO VIDEO ]
            </div>
            <p style="font-family: var(--font-serif); font-style: italic; color: var(--text-inverse-muted); max-width: 50ch; font-size: 0.95rem;">
              A recorded field session documenting pairing, frequency sweep through underwater silt, locating the buried fillámend, and tactile mending.
            </p>
            <span class="archival-badge" style="border-color: rgba(255, 255, 255, 0.2); color: var(--accent-cyan); background: rgba(0, 0, 0, 0.4);">
              MEDIA REF: [DEMO VIDEO URL] // A3-ELIE-READER
            </span>
          </div>
        </div>

        <div style="margin-top: 1.5rem;">
          <h4 style="font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.1em; color: var(--text-inverse); text-transform: uppercase;">
            CYCLE PHASES DEMONSTRATED:
          </h4>
          <div id="demo-stage-timeline" class="demo-stage-timeline">
            <!-- Rendered by main.js -->
          </div>
          <div id="demo-stage-description" style="margin-top: 1rem; font-size: 0.82rem; color: var(--text-inverse-muted); font-family: var(--font-mono);">
            01 — CONNECT: Pairing the handheld Reader to the laptop Field Receiver via WebSocket relay.
          </div>
        </div>
      </div>
    </section>

    <!-- ==================================================================
         08. FIELD NOTES & RESEARCH ARCHIVE
         ================================================================== -->
    <section id="field-notes" class="archive-section">
     <!--<span class="corner-reg tl">+</span>
      <span class="corner-reg tr">+</span>-->
      <br><br><br>

      <div class="section-archival-header">
        <div class="section-meta-header">
          <span class="section-num">08 // RESEARCH ARCHIVE</span>
          <div class="section-line"></div>
          <span class="archival-badge">RESEARCH ARTIFACTS</span>
        </div>
        <h2 class="section-title">Field Notes & Observations</h2>
        <p class="section-tagline">
          The READER emerged through experimentation across acoustic physics, speculative anthropology, and physical computing.
        </p>
      </div>

      <!-- Filter Bar -->
      <div id="field-notes-filter-bar" class="notes-filter-bar">
        <button class="note-filter-btn active" data-category="ALL">ALL ARTIFACTS</button>
        <button class="note-filter-btn" data-category="OBSERVATIONS">OBSERVATIONS</button>
        <button class="note-filter-btn" data-category="MATERIALS">MATERIALS</button>
        <button class="note-filter-btn" data-category="SOUND">SOUND</button>
        <button class="note-filter-btn" data-category="FREQUENCY">FREQUENCY</button>
        <button class="note-filter-btn" data-category="INTERACTION">INTERACTION</button>
        <button class="note-filter-btn" data-category="WORLD-BUILDING">WORLD-BUILDING</button>
      </div>

      <!-- Cards Grid -->
      <div id="field-notes-cards-container" class="notes-cards-grid">
        <!-- Rendered dynamically by field-notes.js -->
      </div>
    </section>

    <!-- ==================================================================
         09. ABOUT THE CREATOR / MAKER
         ================================================================== -->
    <section id="about-maker" class="archive-section">
  <!--<span class="corner-reg tl">+</span>
      <span class="corner-reg tr">+</span>-->
      <br><br><br>

      <div class="section-archival-header">
        <div class="section-meta-header">
          <span class="section-num">09 // RESEARCHER PROFILE</span>
          <div class="section-line"></div>
          <span class="archival-badge">ARCHIVAL MAKER DOSSIER</span>
        </div>
        <h2 class="section-title">About the Maker</h2>
        <p class="section-tagline">
          Design research situated between human-centred systems, sensory perception, and speculative material worlds.
        </p>
      </div>

      <div class="maker-profile-card">
        <div class="plate-header">
          <span class="plate-title">RESEARCHER SPECIFICATION</span>
          <span class="plate-index">DOSSIER // DAC-04-R</span>
        </div>

        <h3 id="creator-name-display" class="maker-name">[CREATOR NAME]</h3>
        <div id="creator-role-display" class="maker-role">Speculative Designer & Systems Researcher</div>

        <p id="creator-bio-display" class="maker-bio">
          [CREATOR BIO: Focused on human-centred design, design research, systems, perception, speculative worlds, and invisible interactions between people, materials, and environments.]
        </p>

        <div class="grid-2col" style="gap: 2rem; margin-top: 2rem;">
          <div>
            <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase;">INSTITUTION / PROGRAM</span>
            <div id="creator-inst-display" style="font-weight: 600; margin-top: 0.25rem;">[PROGRAM / INSTITUTION]</div>
          </div>
          <div>
            <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase;">DESIGN PRACTICE / PORTFOLIO</span>
            <div style="margin-top: 0.25rem;">
              <a id="creator-portfolio-link" href="#" style="color: var(--accent-rust); text-decoration: underline; font-family: var(--font-mono); font-size: 0.82rem;">
                [DESIGN PRACTICE / WEBSITE / PORTFOLIO]
              </a>
            </div>
          </div>
        </div>

        <div class="maker-facets-list">
          <span class="maker-facet-tag">Human-Centred Design</span>
          <span class="maker-facet-tag">Design Research</span>
          <span class="maker-facet-tag">Systemic Perception</span>
          <span class="maker-facet-tag">Speculative Worlds</span>
          <span class="maker-facet-tag">Analogue Computing</span>
          <span class="maker-facet-tag">Invisible Interactions</span>
        </div>
      </div>
    </section>

    <!-- ==================================================================
         10. ENTER THE SIMULATION (TRANSITION CTA)
         ================================================================== -->
    <section id="enter-simulation" class="archive-section" style="border-bottom: none;">
       <!--<span class="corner-reg tl">+</span>
      <span class="corner-reg tr">+</span>-->
      <br><br><br>

      <div class="transition-hero-card">
        <div class="transition-lead-label">
          READY TO ENTER THE FIELD?
        </div>

        <h2 class="transition-headline">
          THE DOCUMENTATION ENDS HERE.<br>
          THE FIELD BEGINS.
        </h2>

        <p class="transition-subtext">
          Step beyond archival records and engage directly with the active DAC-04 simulation.
        </p>

        <a href="http://localhost:8787/laptop/" class="btn-enter-simulation js-enter-sim-btn">
          ENTER SIMULATION →
        </a>

        <div style="margin-top: 2.5rem;">
          <div class="sim-url-meta-box">
            <span>TARGET SIMULATION ENDPOINT:</span>
            <strong class="sim-url-code js-sim-url-display">http://localhost:8787/laptop/</strong>
          </div>
        </div>
      </div>
    </section>
  </main>

    <!-- ==================================================================
         ARCHIVAL FOOTER & COLOPHON
         ================================================================== -->
    <footer class="archive-footer">
      <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 2rem; margin-bottom: 2rem;">
        <div>
          <div style="font-family: var(--font-mono); font-weight: 700; font-size: 1rem; letter-spacing: 0.1em; margin-bottom: 0.5rem;">
            Speculative // Human Centered Design
          </div>
         <!-- <p style="font-size: 0.8rem; color: var(--text-secondary); max-width: 44ch;">
            Official field documentation and onboarding manual for the DACian speculative instrument.
          </p>-->
        </div>

        <div style="display: flex; gap: 2.5rem; font-family: var(--font-mono); font-size: 0.75rem;">
          <!--<div>
            <div style="color: var(--accent-rust); font-weight: 700; margin-bottom: 0.5rem;">SECTIONS</div>
            <ul style="display: flex; flex-direction: column; gap: 0.35rem; color: var(--text-secondary);">
              <li><a href="#the-world">The World</a></li>
              <li><a href="#artifact">Artifact</a></li>
              <li><a href="#first-field">First Field</a></li>
              <li><a href="#field-setup">Field Setup</a></li>
              <li><a href="#demonstration">Demonstration</a></li>
            </ul>
          </div>-->
          <div>
            <div style="color: var(--accent-rust); font-weight: 700; margin-bottom: 0.5rem;">METADATA</div>
            <ul style="display: flex; flex-direction: column; gap: 0.35rem; color: var(--text-secondary);">
              <li>DOC-REF: DAC-04-ARCHIVE</li>
              <li>RELEASE: ONBOARDING PASS</li>
              <li>PROTOCOL: WEBSOCKET</li>
              <li>FREQUENCY: 440 HZ</li>
            </ul>
          </div>
        </div>
      </div>

      <div style="border-top: 1px solid var(--border-light); padding-top: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted);">
        <div>
          ARCHIVAL RECORD © DACIAN EXPEDITION // ALL RIGHTS RESERVED.
        </div>
        <div style="font-style: italic;">
          Notice: Website operates as responsive documentation. Simulation utilizes dual phone/laptop configuration.
        </div>
      </div>
    </footer>

  </div>

  <!-- ====================================================================
       IN-PAGE CONFIGURATION QUICK-SWITCH MODAL
       ==================================================================== -->
  <div id="config-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.75); z-index: 9999; align-items: center; justify-content: center; padding: 1.5rem;">
    <div style="background: var(--bg-card); border: 2px solid var(--border-dark); border-radius: 4px; padding: 2.5rem; max-width: 580px; width: 100%; box-shadow: 0 16px 40px rgba(0,0,0,0.3);">
      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-light); padding-bottom: 1rem; margin-bottom: 1.5rem;">
        <span class="plate-title">ENDPOINT CONFIGURATION</span>
        <button id="close-config-btn" style="font-family: var(--font-mono); font-size: 1.25rem;">✕</button>
      </div>

      <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.5rem;">
        You can configure the simulation destination URL here without modifying code. 
        Changes take effect immediately across all buttons and the QR code.
      </p>

      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <div>
          <label style="display: block; font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; margin-bottom: 0.35rem;">
            SIMULATION_URL (Laptop Field Receiver):
          </label>
          <input type="text" id="modal-sim-url-input" style="width: 100%; padding: 10px 12px; font-family: var(--font-mono); font-size: 0.85rem; border: 1px solid var(--border-medium); border-radius: 2px;">
        </div>

        <div>
          <label style="display: block; font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; margin-bottom: 0.35rem;">
            PHONE_READER_URL (Handheld Phone Link / QR Target):
          </label>
          <input type="text" id="modal-phone-url-input" style="width: 100%; padding: 10px 12px; font-family: var(--font-mono); font-size: 0.85rem; border: 1px solid var(--border-medium); border-radius: 2px;">
        </div>
      </div>

      <div style="margin-top: 2rem; display: flex; justify-content: flex-end; gap: 1rem;">
        <button id="save-config-btn" class="btn-primary" style="padding: 10px 20px; font-size: 0.8rem;">
          SAVE & APPLY ENDPOINTS
        </button>
      </div>
    </div>
  </div>

  <!-- Modular Scripts -->
