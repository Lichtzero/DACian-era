    <!-- ==================================================================
         05. FIELD SETUP & CHECKLIST
         ================================================================== -->
    <section id="field-setup" class="archive-section">
       <!--<span class="corner-reg tl">+</span>
      <span class="corner-reg tr">+</span>-->
      <br><br><br>

      <div class="section-archival-header">
        <div class="section-meta-header">
          <span class="section-num">05 // TECHNICAL DEPLOYMENT</span>
          <div class="section-line"></div>
          <span class="archival-badge">HARDWARE & ENVIRONMENT</span>
        </div>
        <h2 class="section-title">Field Setup</h2>
        <p class="section-tagline">
          Distinguish between mandatory equipment and optimal acoustic conditions before engaging the instrument.
        </p>
      </div>

      <div class="grid-2col">
        <!-- Requirements Specification -->
        <div>
          <div class="archival-plate" style="margin-bottom: 2rem;">
            <div class="plate-header">
              <span class="plate-title">REQUIRED SPECIFICATIONS</span>
              <span class="archival-badge alert">MANDATORY</span>
            </div>
            <ul style="display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.9rem;">
              <li><strong>Laptop Computer:</strong> To run the FIELD RECEIVER visual station.</li>
              <li><strong>Smartphone:</strong> Held in hand to act as the physical READER instrument.</li>
              <li><strong>Modern Web Browser:</strong> Full WebAudio & WebSocket compliance (Chrome, Safari, Firefox).</li>
              <li><strong>Audio Playback:</strong> Phone volume enabled to hear buried acoustic layers.</li>
              <li><strong>Vibration Support:</strong> Phone haptics enabled for proximity pulse feedback.</li>
              <li><strong>Network Connection:</strong> Both devices linked to the same local network or server.</li>
              <li><strong>READER Access / QR Code:</strong> Connection mechanism to pair the phone.</li>
            </ul>
          </div>

          <div class="archival-plate">
            <div class="plate-header">
              <span class="plate-title">RECOMMENDED FOR IMMERSION</span>
              <span class="archival-badge">RECOMMENDED</span>
            </div>
            <ul style="display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.9rem; color: var(--text-secondary);">
              <li>🎧 <strong>Over-Ear Headphones:</strong> Drastically enhances detection of buried voice harmonics.</li>
              <li>🔇 <strong>Quiet Environment:</strong> Minimizes acoustic competition with the subtle drone.</li>
              <li>🖥️ <strong>Full-Screen Browser Mode:</strong> Maximizes cymatic visual clarity on the laptop.</li>
              <li>✋ <strong>Phone Held Firmly in Hand:</strong> Enables immediate detection of resonant haptic pulses.</li>
            </ul>
          </div>
        </div>

        <!-- Interactive Checklist Card -->
        <div>
          <div class="setup-checklist-card">
            <div class="plate-header">
              <span class="plate-title">BEFORE YOU BEGIN // CHECKLIST</span>
              <span id="checklist-status-badge" class="archival-badge">PREPARATION: 0/6 VERIFIED</span>
            </div>
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 1.5rem;">
              Click each condition as you complete your physical setup. Your progress is remembered automatically:
            </p>

            <div id="interactive-checklist-items" class="checklist-items">
              <!-- Rendered dynamically by checklist.js -->
            </div>

            <div style="margin-top: 1.75rem; padding-top: 1rem; border-top: 1px dashed var(--border-light); display: flex; justify-content: space-between; align-items: center;">
              <button id="checklist-reset-btn" class="archival-badge" style="cursor: pointer;">
                RESET CHECKLIST
              </button>
              <span style="font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-muted);">
                PERSISTENT IN LOCALSTORAGE
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

